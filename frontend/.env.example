# --- LoomSense AI frontend environment variables ---
# Copy this file to `.env` and fill in real values for your environment.
# Vite requires the VITE_ prefix for any variable exposed to client code.

# Backend API base URL. Defaults to localhost if unset.
# Production example: https://loomsense-ai.onrender.com/api
VITE_API_BASE_URL=http://localhost:8000/api

# --- Reserved for future phases (not used yet, safe to leave blank) ---
# Phase 13 — Firebase Authentication (client SDK config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=