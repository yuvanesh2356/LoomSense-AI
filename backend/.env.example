# --- LoomSense AI backend environment variables ---
# Copy this file to `.env` and fill in real values for your environment.
# Never commit the real `.env` file.

# Secret used to sign JWTs. MUST be changed to a long random string in
# any environment beyond local development.
JWT_SECRET=loomsense-hackathon-demo-secret

# Database connection string. Defaults to local SQLite if unset.
# Postgres example (Phase 15): postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./loomsense.db

# Comma-separated list of allowed CORS origins. Use "*" only for local dev.
# Production example: https://loomsense.vercel.app,https://www.loomsense.ai
ALLOWED_ORIGINS=*

# --- Reserved for future phases (not used yet, safe to leave blank) ---
# Phase 13 — Firebase Authentication
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Phase 19 — Gemini AI integration
GEMINI_API_KEY=